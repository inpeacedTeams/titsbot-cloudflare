{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "titsbot-cloudflare",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true},
  "hyperdrive": [{"binding": "HYPERDRIVE", "id": "00000000000000000000000000000000"}],
  "durable_objects": {"bindings": [{"name": "CHAT_COORDINATOR", "class_name": "ChatCoordinator"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ChatCoordinator"]}],
  "triggers": {"crons": ["* * * * *"]},
  "vars": {
    "BOT_USERNAME": "REPLACE_WITHOUT_AT",
    "ALLOWED_CHAT_IDS": "-1001234567890",
    "PUBLIC_URL": "https://titsbot-cloudflare.YOUR-SUBDOMAIN.workers.dev",
    "LLM_BASE_URL": "https://api.openai.com/v1",
    "LLM_MODEL": "REPLACE_WITH_JSON_SCHEMA_MODEL"
  },
  "observability": {"enabled": true, "head_sampling_rate": 1}
}
